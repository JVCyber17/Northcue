# Treat binary assets as binary so line ending normalisation (autocrlf) never
# rewrites their bytes. Without this, Word .docx and image files can be
# corrupted on checkout on Windows.
*.docx binary
*.doc  binary
*.pdf  binary
*.pptx binary
*.xlsx binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary

# scripts/engine-baseline/run.js --check compares baseline.txt byte for byte
# against what it regenerates, and it writes LF. With autocrlf on, a Windows
# checkout rewrites the file to CRLF and every one of its 12,000 lines reads as
# changed, so --check reports the whole corpus moved and says nothing about
# what actually did. Found the hard way: a few git checkouts during a bisect
# were enough to break the one gate that guards engine changes.
scripts/engine-baseline/baseline.txt text eol=lf
